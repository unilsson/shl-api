# SHL source
SHL_URL=https://www.shl.se/api/sports-v2/game-schedule
SHL_LOGO_BASE_URL=https://sportality.cdn.s8y.se/team-logos
SHL_SEASON_UUID=ndcf81nlb3
SHL_SERIES_UUID=qQ9-bb0bzEWUk
SHL_GAME_TYPE_UUID=qQ9-af37Ti40B
SHL_GAME_PLACE=all
SHL_PLAYED=all

# Local application data
SHL_DATA_DIR=./data
SHL_CACHE_FILE=./data/schedule.json
